{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "tw.edu.myscreen",
  "version": "2.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.exit",
    "os.execCommand",
    "os.spawnProcess",
    "os.updateSpawnedProcess",
    "os.getPath",
    "os.open",
    "os.setTray",
    "os.showFolderDialog",
    "os.showSaveDialog",
    "filesystem.readFile",
    "filesystem.readBinaryFile",
    "filesystem.writeFile",
    "filesystem.writeBinaryFile",
    "filesystem.readDirectory",
    "filesystem.createDirectory",
    "filesystem.getStats",
    "filesystem.remove",
    "window.show",
    "window.focus",
    "window.isMinimized",
    "window.unminimize",
    "window.isFullScreen",
    "window.setFullScreen",
    "window.exitFullScreen",
    "resources.extractFile",
    "resources.getStats"
  ],
  "globalVariables": {
    "MSROOT": "V:"
  },
  "modes": {
    "window": {
      "title": "黑板樹 Blackboard Tree",
      "useLogicalPixels": true,
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 560,
      "center": true,
      "maximize": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icon.png",
      "enableInspector": false,
      "borderless": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false
    }
  },
  "cli": {
    "binaryName": "blackboardtree",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/neutralino.js",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0"
  }
}
